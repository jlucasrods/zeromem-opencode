{
  "name": "zeromem-opencode",
  "version": "0.1.0",
  "description": "Local cross-session memory for OpenCode inspired by Zero-Mem",
  "type": "module",
  "license": "MIT",
  "repository": "github:jlucasrods/zeromem-opencode",
  "scripts": {
    "build": "cargo build --release --locked --manifest-path sidecar/Cargo.toml",
    "install:global": "node scripts/install.mjs",
    "test:plugin": "node --test test/*.test.mjs",
    "test:sidecar": "cargo test --locked --manifest-path sidecar/Cargo.toml",
    "test": "npm run test:plugin && npm run test:sidecar"
  },
  "engines": {
    "node": ">=18"
  }
}
